# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO SEGURAS (BLINDAJE CLOUD DEVSECOPS)
# ==============================================================================
# NOTA DE SEGURIDAD:
# 1. NUNCA subas credenciales reales a GitHub.
# 2. Configura estas variables directamente en el panel de Vercel (Project Settings > Environment Variables).
# 3. Nunca uses el prefijo NEXT_PUBLIC_ para llaves de backend o base de datos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL (Base de Datos Serverless)
# ------------------------------------------------------------------------------
# DATABASE_URL: Cadena de conexión con PgBouncer (-pooler) y sslmode=require para consultas en Next.js.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-solitary-flower-b40fq2jt-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Cadena de conexión directa (sin pooler) para migraciones de Prisma CLI.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-solitary-flower-b40fq2jt.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Almacenamiento de Archivos S3-Compatible)
# ------------------------------------------------------------------------------
# Account ID de tu cuenta de Cloudflare (obtenible en el panel de Cloudflare)
R2_ACCOUNT_ID="tu_cloudflare_account_id"

# Token de API R2 con permisos de lectura/escritura en el bucket
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"

# Nombre del bucket en Cloudflare R2
R2_BUCKET_NAME="autotech-storage"

# Dominio público personalizado configurado en Cloudflare R2 (opcional para imágenes públicas de catálogo)
R2_PUBLIC_DOMAIN="cdn.tudominio.com"

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN Y SEGURIDAD DE SESIÓN (NextAuth / JWT)
# ------------------------------------------------------------------------------
# Genera un string aleatorio de 32 bytes con: openssl rand -base64 32
NEXTAUTH_SECRET="tu_secreto_super_seguro_min_32_caracteres"

# URL canónica de producción (tu dominio gestionado en Hostinger + Cloudflare)
NEXTAUTH_URL="https://tudominio.com"

# Entorno de ejecución
NODE_ENV="production"
