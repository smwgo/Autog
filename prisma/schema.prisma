generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  name                String
  avatar              String?
  role                UserRole              @default(CLIENT)
  FinancialComparison FinancialComparison[]

  @@index([role])
}

model City {
  id                                                              String                @id
  slug                                                            String                @unique
  name                                                            String
  country                                                         String
  countryCode                                                     String
  flag                                                            String?
  currency                                                        String
  region                                                          String?
  source                                                          String                @default("seed")
  createdAt                                                       DateTime              @default(now())
  updatedAt                                                       DateTime
  CityCostItem                                                    CityCostItem[]
  FinancialComparison_FinancialComparison_destinationCityIdToCity FinancialComparison[] @relation("FinancialComparison_destinationCityIdToCity")
  FinancialComparison_FinancialComparison_originCityIdToCity      FinancialComparison[] @relation("FinancialComparison_originCityIdToCity")

  @@index([country, name])
}

model CityCostCategory {
  id           String         @id
  code         String         @unique
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  CityCostItem CityCostItem[]

  @@index([name])
}

model CityCostItem {
  id               String           @id
  cityId           String
  categoryId       String
  amount           Decimal          @db.Decimal(14, 2)
  currency         String
  period           String           @default("monthly")
  source           String           @default("seed")
  updatedAt        DateTime         @default(now())
  CityCostCategory CityCostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  City             City             @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, categoryId])
  @@index([source])
}

model FinancialComparison {
  id                                               String   @id
  userId                                           String
  originCityId                                     String
  destinationCityId                                String
  periodMonths                                     Int      @default(1)
  monthlyDifference                                Decimal? @db.Decimal(14, 2)
  installationCost                                 Decimal? @db.Decimal(14, 2)
  createdAt                                        DateTime @default(now())
  updatedAt                                        DateTime
  City_FinancialComparison_destinationCityIdToCity City     @relation("FinancialComparison_destinationCityIdToCity", fields: [destinationCityId], references: [id], onDelete: Cascade)
  City_FinancialComparison_originCityIdToCity      City     @relation("FinancialComparison_originCityIdToCity", fields: [originCityId], references: [id], onDelete: Cascade)
  User                                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([originCityId, destinationCityId])
  @@index([userId, createdAt])
}

model ShoppingCategory {
  id           String         @id
  name         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ShoppingItem ShoppingItem[]

  @@index([name])
}

model ShoppingItem {
  id                 String               @id
  shoppingListId     String
  categoryId         String
  name               String
  quantity           Decimal              @db.Decimal(14, 3)
  unit               String               @default("unidad")
  estimatedUnitPrice Decimal              @db.Decimal(14, 2)
  actualUnitPrice    Decimal?             @db.Decimal(14, 2)
  priority           ShoppingItemPriority @default(MEDIUM)
  status             ShoppingItemStatus   @default(PENDING)
  isRequired         Boolean              @default(true)
  storeId            String?
  notes              String?
  sourceType         String?
  sourceId           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  ShoppingCategory   ShoppingCategory     @relation(fields: [categoryId], references: [id])
  ShoppingList       ShoppingList         @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ShoppingStore      ShoppingStore?       @relation(fields: [storeId], references: [id])

  @@index([categoryId, status])
  @@index([shoppingListId, isRequired])
  @@index([shoppingListId, priority])
  @@index([shoppingListId, status])
  @@index([sourceType, sourceId])
  @@index([storeId, status])
  @@index([updatedAt])
}

model ShoppingList {
  id           String             @id
  userId       String
  name         String
  countryId    String
  cityId       String
  currency     String             @default("EUR")
  status       ShoppingListStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  ShoppingItem ShoppingItem[]

  @@index([countryId, cityId])
  @@index([status, updatedAt])
  @@index([userId])
}

model ShoppingStore {
  id           String         @id
  name         String
  address      String?
  website      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ShoppingItem ShoppingItem[]

  @@index([name])
}

enum ShoppingItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ShoppingItemStatus {
  PENDING
  PURCHASED
  SKIPPED
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum UserRole {
  CLIENT
  PARTNER
  SALES
  SUPPORT
  ROOT
}
